# ==============================================================================
# FitBuddy - Environment Variables Configuration
# Copy this file to .env and set your Google Gemini API key.
# ==============================================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Defaults to modern high-speed gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash

# SQLite Database Location
DATABASE_URL=sqlite:///./fitbuddy.db

# Enable mock plan fallback when Gemini API key is missing or quota exceeded
ENABLE_MOCK_FALLBACK=true

# Debug Mode
DEBUG=false
